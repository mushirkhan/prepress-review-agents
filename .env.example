# Copy to .env and fill in. Never commit the real .env.

# --- Cloudflare Tunnel (app VM only) ---
TUNNEL_TOKEN=

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_ORCHESTRATOR_MODEL=amazon.nova-lite-v1:0
BEDROCK_SPECIALIST_MODEL=amazon.nova-micro-v1:0
BEDROCK_VISION_MODEL=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- Cognito (existing user pool, new SPA app client) ---
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REQUIRED_GROUP=prepress-reviewers

# --- App ---
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_BYTES=204800
DAILY_REVIEW_LIMIT=5
