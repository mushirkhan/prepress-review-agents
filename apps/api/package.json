{
  "name": "@prepress/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "samples": "tsx scripts/generate-samples.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.105",
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "@mastra/core": "^1.74.0",
    "hono": "^4.13.13",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
