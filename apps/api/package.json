{
  "name": "@prepress/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "samples": "tsx scripts/generate-samples.ts",
    "review": "node --env-file-if-exists=../../.env --import tsx scripts/review-sample.ts",
    "eval": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning --import tsx evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.105",
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "@mastra/core": "^1.74.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.13",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
